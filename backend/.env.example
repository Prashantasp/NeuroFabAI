# =============================================================================
# NeuroFab AI - backend configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# Anything not set here falls back to the default in app/core/config.py.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | staging | production
# staging/production enable strict startup checks (see SECURITY below) and
# disable /docs, /redoc and /openapi.json.
ENVIRONMENT=development
PROJECT_NAME="NeuroFab AI"
API_V1_STR=/api/v1
DEBUG=false

# --- Database (REQUIRED) ------------------------------------------------------
# PostgreSQL. Provided by docker-compose for local development.
DATABASE_URL=postgresql+psycopg2://neurofab:neurofab_password@localhost:5432/neurofab_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Security (REQUIRED in production) ----------------------------------------
# Two DIFFERENT random values, >= 32 characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START in staging/production if these are left at the
# placeholder values, are shorter than 32 chars, or are identical.
SECRET_KEY=CHANGE_ME_access_token_signing_key_min_32_chars
JWT_SECRET=CHANGE_ME_refresh_token_signing_key_min_32_chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie. COOKIE_SECURE MUST be true in production (enforced at
# startup) so the session cookie is only ever sent over HTTPS.
COOKIE_SECURE=false
# lax | strict | none. Use "none" (with COOKIE_SECURE=true) only when the API and
# frontend are on different sites.
COOKIE_SAMESITE=lax
# Set to a shared parent domain (e.g. .example.com) for cross-subdomain sessions.
COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128

# --- Rate limiting ------------------------------------------------------------
# In-process fixed-window limiter. Correct for a single backend instance; behind
# multiple replicas each replica enforces its own window.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- AI provider (REQUIRED for Copilot and graph extraction) ------------------
# Google Gemini API key: https://aistudio.google.com/apikey
# Either variable name works; GOOGLE_API_KEY is what the google-genai SDK uses.
# Server-side only -- this value is NEVER sent to the browser.
#
# Without it: sign-in, uploads, text extraction, chunking, local embeddings and
# vector search all work; the Copilot returns a clear "AI not configured" error
# and knowledge-graph extraction is skipped. Nothing is faked.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# gemini | null   ("null" disables AI entirely, for CI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# EMBEDDING_DIMENSION must match the Qdrant collection. Changing it after
# documents are indexed requires deleting and rebuilding the collection.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=32

# --- Vector store -------------------------------------------------------------
# If unreachable, the app falls back to embedded on-disk storage at
# QDRANT_LOCAL_PATH (development convenience; use a real server in production).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=neurofab_documents
QDRANT_LOCAL_PATH=./qdrant_data

# --- Knowledge graph ----------------------------------------------------------
# neo4j | networkx
# "networkx" is in-memory and non-persistent: it is rebuilt from PostgreSQL on
# every boot. Use neo4j in production.
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neurofab_password

# --- Ingestion ----------------------------------------------------------------
# Relative paths resolve against the backend directory.
STORAGE_DIR=data/documents
MAX_UPLOAD_BYTES=52428800
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Chunks sent to the model for graph extraction. Higher = better coverage, more
# tokens per document.
EXTRACTION_MAX_CHUNKS=24

# --- CORS (REQUIRED) ----------------------------------------------------------
# Exact frontend origins, comma-separated or a JSON array. Credentials are sent
# with every request, so "*" is rejected and http:// origins are rejected in
# production.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
